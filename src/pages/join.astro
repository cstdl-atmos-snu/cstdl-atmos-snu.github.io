---
import Layout from '../layouts/Layout.astro';
import { Mail, GraduationCap, BookOpen, Users } from 'lucide-react';
import { SITE } from '../config';

const roles = [
  { icon: Users, title: 'Postdoctoral researchers', text: 'Researchers with a Ph.D. in atmospheric science or a related field who want to work on tropical convection, the MJO, tropical cyclones, or extreme precipitation.' },
  { icon: GraduationCap, title: 'Graduate students', text: 'M.S., Ph.D., and integrated M.S./Ph.D. students in the School of Earth and Environmental Sciences.' },
  { icon: BookOpen, title: 'Undergraduate interns', text: 'Undergraduates who want hands-on research experience with observations, models, or machine learning.' },
];
---

<Layout title="Join Us">
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Join us</h1>
      <p class="text-lg text-gray-600">We are looking for postdoctoral researchers, graduate students, and undergraduate interns.</p>
      <p class="text-gray-600 mt-2">학부인턴, 석·박사과정 학생, 박사후연구원을 모집합니다.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-3 mb-12">
      {roles.map(r => (
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
          <div class="w-11 h-11 bg-blue-50 rounded-xl flex items-center justify-center mb-4 text-blue-600"><r.icon className="w-5 h-5" /></div>
          <h2 class="text-lg font-bold text-gray-900 mb-2">{r.title}</h2>
          <p class="text-sm text-gray-600">{r.text}</p>
        </div>
      ))}
    </div>

    <div class="bg-gray-50 rounded-3xl p-8 sm:p-10">
      <h2 class="text-2xl font-bold text-gray-900 mb-3">How to apply</h2>
      <p class="text-gray-600 mb-6">Please email a CV and a short statement of your research interests. 관심 있는 분은 CV와 관심 연구 분야를 간단히 적어 보내 주세요.</p>
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors">
        <Mail className="w-4 h-4" /> {SITE.email}
      </a>
    </div>
  </div>
</Layout>
